{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bragi",
  "version": "1.1.1",
  "identifier": "com.lin.bragi",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Bragi",
        "width": 1200,
        "height": 800,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDExM0FBM0JFODI2M0FDNjYKUldSbXJHT0N2cU02RVNPQ09hQ29jUW5KZXgyZFlrUWMvSE1kakpMZ2p6QmxHTHZtTFJEOUNIcjEK",
      "endpoints": [
        "https://github.com/moonlight-system/Bragi/releases/latest/download/latest.json"
      ]
    }
  }
}
